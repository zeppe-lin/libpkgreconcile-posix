option(
  'link_mode',
  type: 'combo',
  choices: ['shared', 'static'],
  value: 'shared',
  description: 'Library linkage mode; must match default_library',
)
option(
  'tests',
  type: 'feature',
  value: 'enabled',
  description: 'Build and run the libpkgreconcile-posix test suite',
)
option(
  'man_pages',
  type: 'feature',
  value: 'auto',
  description: 'Build manual pages with scdoc',
)
